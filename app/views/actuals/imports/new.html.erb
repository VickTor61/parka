<%= render "shared/modal" do %>
  <%= form_with model: @import, scope: :actuals_import, url: actuals_import_path do |form| %>
    <%= render "shared/modal/header", title: "Import actuals" %>

    <div class="space-y-4 px-4 py-4">
      <%= render "shared/form_errors", record: @import %>

      <div>
        <%= form.label :file, "CSV file", class: field_label_class %>
        <%= form.file_field :file, accept: ".csv,text/csv", class: "block w-full cursor-pointer rounded-lg border border-gray-300 p-2 text-sm text-gray-700 file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-gray-900 file:px-2.5 file:py-1.5 file:text-sm file:font-medium file:text-white", required: true %>
        <p class="mt-1.5 text-xs text-gray-400">
          Up to <%= number_to_human_size(ActualsImport::MAX_BYTES) %> and <%= number_with_delimiter(ActualsImport::MAX_ROWS) %> rows.
        </p>
      </div>

      <%= link_to actuals_import_template_path(format: :csv), class: "flex items-center justify-between gap-3 rounded-lg border border-gray-200 p-3 transition-colors hover:bg-gray-50", data: { turbo: false } do %>
        <span class="min-w-0">
          <span class="block text-sm font-medium text-gray-900">Download the template</span>
          <span class="block text-xs text-gray-500">A ready-made CSV with the right columns and example rows.</span>
        </span>

        <%= inline_svg_tag("upload.svg", class: "size-4 shrink-0 rotate-180 text-gray-500") %>
      <% end %>

      <dl class="space-y-1.5 rounded-lg bg-gray-50 p-3 text-xs">
        <div class="flex gap-2">
          <dt class="w-20 shrink-0 text-gray-500">Columns</dt>
          <dd class="text-gray-900"><span class="font-medium">month, category, amount</span> — note is optional</dd>
        </div>

        <div class="flex gap-2">
          <dt class="w-20 shrink-0 text-gray-500">Month</dt>
          <dd class="text-gray-900">YYYY-MM, e.g. 2026-01</dd>
        </div>

        <div class="flex gap-2">
          <dt class="w-20 shrink-0 text-gray-500">Category</dt>
          <dd class="text-gray-900">Must already exist</dd>
        </div>

        <div class="flex gap-2">
          <dt class="w-20 shrink-0 text-gray-500">Amount</dt>
          <dd class="text-gray-900">A number, zero or above</dd>
        </div>
      </dl>

      <p class="text-sm text-gray-500">If any row fails, nothing is imported — fix the file and try again.</p>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Import" %>
  <% end %>
<% end %>

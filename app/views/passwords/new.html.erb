<% content_for :title, "Reset password" %>

<%= render layout: "shared/auth/page", locals: { title: "Forgot Password", subtitle: "We'll email you a link to set a new one." } do %>
  <%= form_with(url: passwords_path, class: "space-y-8") do |form| %>
    <%= render "shared/auth/email_field", form: form, value: params[:email_address] %>

    <%= form.submit "Email reset instructions", class: auth_button_class %>
  <% end %>

  <p class="mt-6 text-center">
    <%= link_to "Back to log in", new_session_path, class: auth_link_class %>
  </p>
<% end %>

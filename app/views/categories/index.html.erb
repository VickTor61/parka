<% content_for :title, "Categories" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [{ pathname: "Categories" }] %>
<% end %>

<%= render "shared/page_header",
    title: "Categories",
    description: "Spending categories you assign targets and entries to." %>

<%= search_form_for @q, url: categories_path, class: "contents", data: { controller: "search", turbo_action: "replace", turbo_frame: "categories_table" } do |form| %>
  <%= render "shared/toolbar",
      form: form,
      search_key: :name_cont,
      search_placeholder: "Search name",
      frame: "categories_table",
      reset_path: categories_path,
      active_filters: search_chips(name_cont: { label: "Search" }),
      action: link_to(new_category_path, class: primary_button_class, data: { turbo_frame: "modal" }) {
        inline_svg_tag("plus.svg", class: "size-4") + "Add category"
      } %>
<% end %>

<%= turbo_frame_tag "categories_table" do %>
  <% if @categories.empty? %>
    <div class="mt-4">
      <%= render "shared/empty_state",
          icon: "tag.svg",
          title: params.dig(:q, :name_cont).present? ? "No matching categories" : "No categories yet",
          description: params.dig(:q, :name_cont).present? ? "No category matches that search." : "Add a category to start setting monthly targets.",
          action: link_to(new_category_path, class: primary_button_class, data: { turbo_frame: "modal" }) {
            inline_svg_tag("plus.svg", class: "size-4") + "Add category"
          } %>
    </div>
  <% else %>
    <%= render layout: "shared/table", locals: { columns: [{ label: "Name" }, { label: "Targets" }, { label: "Entries" }, { label: "", class: "w-24" }] } do %>
      <% @categories.each do |category| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-4 text-sm font-medium whitespace-nowrap text-gray-900"><%= category.name %></td>
          <td class="px-4 py-4 text-sm whitespace-nowrap text-gray-500"><%= category.plans.size %></td>
          <td class="px-4 py-4 text-sm whitespace-nowrap text-gray-500"><%= category.actuals.size %></td>
          <td class="px-4 py-4 text-sm whitespace-nowrap">
            <div class="flex items-center justify-end gap-1">
              <%= link_to edit_category_path(category), class: "rounded-md p-1.5 text-gray-500 hover:bg-gray-100 hover:text-gray-900", data: { turbo_frame: "modal" }, aria: { label: "Edit #{category.name}" } do %>
                <%= inline_svg_tag("pencil.svg", class: "size-4") %>
              <% end %>

              <%= button_to category_path(category), method: :delete, class: "cursor-pointer rounded-md p-1.5 text-gray-500 hover:bg-gray-100 hover:text-red-600", form: { data: { turbo_confirm: "Delete #{category.name}?", turbo_frame: "_top" } }, aria: { label: "Delete #{category.name}" } do %>
                <%= inline_svg_tag("trash.svg", class: "size-4") %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    <% end %>

    <%= render "shared/pagination", pagy: @pagy, url: categories_path, frame: "categories_table" %>
  <% end %>
<% end %>

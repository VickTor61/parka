<%= form_with url: reports_path, method: :get, class: "contents", data: { controller: "search", turbo_action: "replace", turbo_frame: "report_table" } do |form| %>
  <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-x-3">
      <div class="flex h-[34px] w-[200px] items-center gap-2 rounded-lg border border-slate-200 px-2 shadow-xs">
        <%= inline_svg_tag("search.svg", class: "size-4 shrink-0 text-gray-500") %>
        <%= form.search_field :query, value: report.query, placeholder: "Search category", class: "w-full text-sm text-gray-900 outline-none placeholder:text-gray-400", data: { action: "input->search#submitForm" } %>
      </div>

      <div data-controller="dropdown" class="relative">
        <button type="button" data-action="dropdown#toggle" data-dropdown-target="button" class="flex h-[34px] cursor-pointer items-center gap-1.5 rounded-lg border px-2.5 py-2 font-medium transition-colors <%= report.filtered_by_range_or_category? ? 'border-gray-900 bg-gray-900 text-white' : 'border-slate-200 text-gray-700 shadow-xs hover:bg-gray-100' %>">
          <%= inline_svg_tag("list-filter.svg", class: "size-4 shrink-0") %>
          <span class="text-sm">Filter</span>
        </button>

        <div data-dropdown-target="menu" class="z-20 hidden rounded-lg border border-gray-200 bg-white p-3 shadow-md max-sm:fixed max-sm:left-1/2 max-sm:w-[calc(100vw-2rem)] max-sm:max-w-sm max-sm:-translate-x-1/2 sm:absolute sm:top-full sm:left-0 sm:mt-1.5 sm:w-72">
          <div class="space-y-3">
            <div class="grid grid-cols-2 gap-2">
              <div>
                <%= form.label :from, "From", class: field_label_class %>
                <%= form.text_field :from, value: report.month_param(report.from), placeholder: "YYYY-MM", class: field_class, data: { controller: "month-picker" } %>
              </div>

              <div>
                <%= form.label :to, "To", class: field_label_class %>
                <%= form.text_field :to, value: report.month_param(report.to), placeholder: "YYYY-MM", class: field_class, data: { controller: "month-picker" } %>
              </div>
            </div>

            <div>
              <span class="<%= field_label_class %>">Fiscal year</span>
              <div class="grid grid-cols-2 gap-2">
                <%= form.select :fiscal_year,
                    options_for_select(fiscal_year_options, report.fiscal_year),
                    { include_blank: "Not set" }, class: field_class %>

                <%= form.select :fiscal_start_month,
                    options_for_select(fiscal_start_month_options, report.fiscal_start_month),
                    {}, class: field_class %>
              </div>
              <p class="mt-1 text-xs text-gray-400">Starts in the month you pick.</p>
            </div>

            <div>
              <span class="<%= field_label_class %>">Quick range</span>
              <% year = (report.from || report.to || Date.current).year %>
              <div class="flex flex-wrap gap-1.5">
                <% quarter_ranges(year).each do |range| %>
                  <%= link_to range[:label], reports_path(from: range[:from], to: range[:to], query: report.query, category_id: report.category_id),
                      class: "rounded-md border px-2 py-1 text-xs font-medium transition-colors #{report.range?(range[:from], range[:to]) ? 'border-gray-900 bg-gray-900 text-white' : 'border-slate-200 text-gray-700 hover:bg-gray-100'}" %>
                <% end %>

                <%= link_to "Full year", reports_path(from: "#{year}-01", to: "#{year}-12", query: report.query, category_id: report.category_id),
                    class: "rounded-md border px-2 py-1 text-xs font-medium transition-colors #{report.range?("#{year}-01", "#{year}-12") ? 'border-gray-900 bg-gray-900 text-white' : 'border-slate-200 text-gray-700 hover:bg-gray-100'}" %>

                <%= link_to "All time", reports_path(query: report.query, category_id: report.category_id),
                    class: "rounded-md border px-2 py-1 text-xs font-medium transition-colors #{report.full_range? ? 'border-gray-900 bg-gray-900 text-white' : 'border-slate-200 text-gray-700 hover:bg-gray-100'}" %>
              </div>
            </div>

            <div class="flex items-center justify-between border-t border-gray-200 pt-3">
              <%= link_to "Clear", reports_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
              <%= form.submit "Apply", class: primary_button_class %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%= link_to reports_path(request.query_parameters.merge(format: :csv)), class: secondary_button_class, data: { turbo: false } do %>
      <%= inline_svg_tag("upload.svg", class: "size-4") %>Export CSV
    <% end %>
  </div>

  <% chips = report.active_filters(categories) %>

  <% if chips.any? %>
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      <% chips.each do |chip| %>
        <%= filter_chip chip[:label], chip[:value], reports_path(chip[:without]) %>
      <% end %>

      <%= link_to "Clear all", reports_path, class: "ml-1 text-xs font-medium text-gray-500 hover:text-gray-900 hover:underline" %>
    </div>
  <% end %>
<% end %>

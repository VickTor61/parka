<div class="mt-4 overflow-auto rounded-md border border-slate-200">
  <table class="min-w-full">
    <thead>
      <tr class="border-b border-slate-200 antialiased">
        <% [ "Category", "Month", "Plan", "Actual", "Variance", "Variance %", "Status" ].each do |label| %>
          <th scope="col" class="px-4 py-2.5 text-left text-sm font-medium whitespace-nowrap text-slate-500 capitalize"><%= label %></th>
        <% end %>
      </tr>
    </thead>

    <tbody class="bg-white">
      <% rows.each do |row| %>
        <tr class="<%= report_row_class %>">
          <td class="<%= report_cell_class %> font-medium text-gray-900"><%= row.category_name %></td>
          <td class="<%= report_cell_class %> text-gray-500"><%= month_label(row.month) %></td>
          <td class="<%= report_cell_class %> text-gray-900"><%= money(row.plan) %></td>

          <td class="<%= report_cell_class %> text-gray-900">
            <% if row.reported? %>
              <%= link_to money(row.actual), reports_entries_path(category_id: row.category_id, month: row.month.strftime(MonthlyPeriod::FORMAT)),
                  class: "font-medium text-gray-900 underline decoration-gray-300 underline-offset-2 hover:decoration-gray-900",
                  data: { turbo_frame: "modal" },
                  title: "See the entries behind this" %>
            <% else %>
              <%= blank_cell %>
            <% end %>
          </td>

          <td class="<%= report_cell_class %> <%= variance_class(row.variance) %>"><%= signed_money(row.variance) %></td>
          <td class="<%= report_cell_class %> <%= variance_class(row.variance) %>"><%= signed_percentage(row.variance_percentage) %></td>
          <td class="<%= report_cell_class %>"><%= lock_badge(locked_months.include?(row.month)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% content_for :title, "#{@category.name} entries" %>

<%= render "shared/modal", width_class: "w-[520px]" do %>
  <%= render "shared/modal/header", title: "#{@category.name} — #{month_label(@month)}" %>

  <div class="max-h-[420px] overflow-y-auto px-4 py-4">
    <% if @entries.any? %>
      <ul class="divide-y divide-gray-200">
        <% @entries.each do |entry| %>
          <li>
            <%= link_to actuals_path(q: { category_id_eq: @category.id, month_eq: @month }), class: "-mx-2 flex items-start justify-between gap-3 rounded-md px-2 py-2.5 transition-colors hover:bg-gray-50", data: { turbo_frame: "_top" } do %>
              <span class="min-w-0">
                <span class="block text-sm font-medium text-gray-900"><%= money(entry.amount) %></span>
                <span class="block truncate text-sm text-gray-500"><%= entry.note.presence || "No note" %></span>
              </span>

              <span class="shrink-0 text-xs text-gray-400"><%= entry.created_at.strftime("%b %d, %Y") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">No entries logged for this category and month.</p>
    <% end %>
  </div>

  <div class="mt-2 flex shrink-0 items-center justify-between border-t border-gray-200 px-4 py-3">
    <span class="text-sm text-gray-500">
      <%= pluralize(@entries.size, "entry") %> — <%= money(@entries.sum(&:amount)) %>
      <%= " · locked" if @locked %>
    </span>

    <%= link_to "Open in Actuals", actuals_path(q: { category_id_eq: @category.id, month_eq: @month }), class: secondary_button_class, data: { turbo_frame: "_top" } %>
  </div>
<% end %>

<% flash_styles = {
  "notice"  => "bg-black",
  "success" => "bg-emerald-600",
  "alert"   => "bg-amber-500",
  "error"   => "bg-red-600"
} %>

<% flash.each do |key, value| %>
  <% message = value.is_a?(Hash) ? value[:message] : value %>
  <% bg = flash_styles[key] || flash_styles["notice"] %>

  <div data-controller="toast" aria-live="assertive" class="fixed top-4 z-30 flex w-full justify-center px-4">
    <div class="pointer-events-auto w-fit rounded-lg <%= bg %> p-3 text-sm font-medium text-white shadow-md">
      <%= message %>
    </div>
  </div>
<% end %>

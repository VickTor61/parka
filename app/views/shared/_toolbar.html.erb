<% has_filters = local_assigns[:filters].present? %>

<div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex items-center gap-x-3">
    <div class="flex h-[34px] w-[200px] items-center gap-2 rounded-lg border border-slate-200 px-2 shadow-xs">
      <%= inline_svg_tag("search.svg", class: "size-4 shrink-0 text-gray-500") %>
      <%= form.search_field search_key, placeholder: local_assigns[:search_placeholder] || "Search", class: "w-full text-sm text-gray-900 outline-none placeholder:text-gray-400", data: { action: "input->search#submitForm" } %>
    </div>

    <% if has_filters %>
      <div data-controller="dropdown" class="relative">
        <button type="button" data-action="dropdown#toggle" data-dropdown-target="button" class="flex h-[34px] cursor-pointer items-center gap-1.5 rounded-lg border px-2.5 py-2 font-medium transition-colors <%= active_filters.any? ? 'border-gray-900 bg-gray-900 text-white' : 'border-slate-200 text-gray-700 shadow-xs hover:bg-gray-100' %>">
          <%= inline_svg_tag("list-filter.svg", class: "size-4 shrink-0") %>
          <span class="text-sm">Filter</span>
        </button>

        <div data-dropdown-target="menu" class="z-20 hidden rounded-lg border border-gray-200 bg-white p-3 shadow-md max-sm:fixed max-sm:left-1/2 max-sm:w-[calc(100vw-2rem)] max-sm:max-w-sm max-sm:-translate-x-1/2 sm:absolute sm:top-full sm:left-0 sm:mt-1.5 sm:w-72">
          <div class="space-y-3"><%= filters %></div>

          <div class="mt-3 flex items-center justify-between border-t border-gray-200 pt-3">
            <%= link_to "Clear", reset_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <%= form.submit "Apply", class: primary_button_class, data: { turbo_frame: "_top" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if local_assigns[:action] %>
    <div class="shrink-0"><%= action %></div>
  <% end %>
</div>

<% if active_filters.any? %>
  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    <% active_filters.each do |chip| %>
      <%= filter_chip chip[:label], chip[:value], chip[:without] %>
    <% end %>

    <%= link_to "Clear all", reset_path, class: "ml-1 text-xs font-medium text-gray-500 hover:text-gray-900 hover:underline" %>
  </div>
<% end %>

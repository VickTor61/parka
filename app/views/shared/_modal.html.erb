<% width_class = local_assigns.fetch(:width_class, "w-[500px]") %>

<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal" data-modal-target="modal" role="dialog" aria-modal="true" class="fixed inset-0 z-50">
    <div data-action="click->modal#closeModal" data-modal-target="backdrop" class="fixed inset-0 z-20 cursor-default bg-black/25 opacity-0 transition-opacity duration-300 ease-in-out"></div>

    <div class="relative h-screen w-screen overflow-y-auto">
      <div class="flex min-h-full items-center justify-center text-center">
        <div data-modal-target="panel" class="relative z-30 mx-2 max-w-[calc(100vw-1rem)] scale-95 transform overflow-hidden rounded-lg bg-white text-left opacity-0 shadow-xl transition-all duration-300 ease-in-out <%= width_class %>">
          <%= yield %>
        </div>
      </div>
    </div>
  </div>
<% end %>

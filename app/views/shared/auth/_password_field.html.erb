<div data-controller="visibility" class="space-y-1.5">
  <div class="flex items-center justify-between">
    <%= form.label field, local_assigns[:label], class: auth_label_class %>

    <% if local_assigns[:link_text] %>
      <%= link_to link_text, link_path, class: "text-sm font-medium tracking-tight text-stone-950" %>
    <% end %>
  </div>

  <div class="relative">
    <%= form.password_field field, placeholder: placeholder, class: auth_input_class, required: true, autofocus: local_assigns[:autofocus], autocomplete: autocomplete, minlength: local_assigns[:minlength], maxlength: 72, data: { visibility_target: "password" } %>

    <button type="button" data-action="visibility#toggle" class="absolute top-2.5 right-2.5 cursor-pointer">
      <%= inline_svg_tag("eye.svg", class: "h-4 w-4", data: { visibility_target: "showIcon" }) %>
      <%= inline_svg_tag("eye-off.svg", class: "hidden h-4 w-4", data: { visibility_target: "hideIcon" }) %>
    </button>
  </div>
</div>

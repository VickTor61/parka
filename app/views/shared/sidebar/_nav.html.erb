<li>
  <%= link_to item[:path], class: "mb-1.5 flex w-full items-center gap-x-2.5 rounded-lg px-2.5 py-2 text-sm font-medium transition-colors #{active_nav?(item[:path]) ? 'bg-gray-200 text-gray-900' : 'text-gray-500 hover:bg-gray-100 hover:text-gray-900'}" do %>
    <%= inline_svg_tag(item[:svg], class: "size-4") %>
    <span><%= item[:text] %></span>
  <% end %>
</li>

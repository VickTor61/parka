<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Parka" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Parka" />
    <meta name="mobile-web-app-capable" content="yes" />
    <%= csrf_meta_tags %> <%= csp_meta_tag %> <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="scheme-light bg-white">
    <main data-controller="sidebar" class="w-full h-full">
      <%= render "shared/sidebar/mobile" %>
      <div class="h-full w-full">
        <div id="flash_messages"><%= render "shared/flash" %></div>

        <%= turbo_frame_tag "modal" %>

        <%= render "shared/sidebar/desktop" %>

        <div class="w-full lg:pl-72">
          <%= render "shared/topbar" %>

          <div
            class="mt-14.5 w-full grow px-4 mx-auto max-w-7xl sm:px-6 lg:px-8 pb-6"
          >
            <%= yield %>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>

<div data-controller="clipboard" data-clipboard-text-value="<%= token %>" class="mt-4 rounded-md border border-gray-900 bg-gray-50 p-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm font-medium text-gray-900">Copy <%= name %> now</p>
      <p class="mt-0.5 text-xs text-gray-500">This is the only time the token is shown. Rotate it if you lose it.</p>
    </div>

    <button type="button" data-action="clipboard#copy" class="inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-md border border-gray-200 bg-white px-2.5 py-1.5 text-sm font-medium text-gray-900 shadow-sm transition-colors hover:bg-gray-100">
      <%= inline_svg_tag("copy.svg", class: "size-4", data: { clipboard_target: "copyIcon" }) %>
      <%= inline_svg_tag("check.svg", class: "size-4 hidden text-emerald-600", data: { clipboard_target: "checkIcon" }) %>
      Copy
    </button>
  </div>

  <code class="mt-3 block overflow-x-auto rounded-md border border-gray-200 bg-white px-2.5 py-2 font-mono text-xs text-gray-900"><%= token %></code>
</div>
